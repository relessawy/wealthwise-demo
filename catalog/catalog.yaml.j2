apiVersion: backstage.io/v1alpha1
kind: System
metadata:
  name: wealthwise
  title: WealthWise Banking Demonstration
  description: Financial guidance, investment scenarios and private user history.
spec:
  owner: group:default/developers
---
apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: wealthwise
  title: WealthWise
  description: ACME Bank financial guidance application with Keycloak sign-in and private history. Scripted demonstration; no live AI.
  tags: [quarkus, java, banking]
  annotations:
{% if splunk_enabled | default(false) %}
    demo-library.io/splunk-binding: wealthwise-demo
{% endif %}
    backstage.io/source-location: url:https://github.com/relessawy/wealthwise-demo/tree/{{ source_ref }}
  links:
  - title: Open WealthWise
    url: '{{ application_url }}'
    icon: web
  - title: Interactive API explorer
    url: '{{ application_url }}/q/swagger-ui/'
    icon: dashboard
  - title: Implementation handover
    url: https://github.com/relessawy/wealthwise-demo/blob/{{ source_ref }}/docs/IMPLEMENTATION.md
    icon: docs
spec:
  # The Quarkus frontend is also the authenticated backend-for-frontend API.
  type: service
  lifecycle: experimental
  owner: group:default/developers
  system: wealthwise
  providesApis: [wealthwise-api]
  dependsOn: [component:wealthwise-financial-advisor, component:wealthwise-investment-advisor, component:wealthwise-history]
{% for name, title in [('financial-advisor','Financial Advisor'), ('investment-advisor','Investment Scenarios'), ('history','Private History')] %}
---
apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: wealthwise-{{ name }}
  title: WealthWise {{ title }}
  description: Internal WealthWise service; access through the authenticated frontend.
spec:
  type: service
  lifecycle: experimental
  owner: group:default/developers
  system: wealthwise
  dependsOn: [{{ 'resource:wealthwise-postgresql' if name == 'history' else 'component:wealthwise-history' }}]
{% endfor %}
---
apiVersion: backstage.io/v1alpha1
kind: Resource
metadata:
  name: wealthwise-postgresql
  title: WealthWise PostgreSQL
spec:
  type: database
  owner: group:default/developers
  system: wealthwise
---
apiVersion: backstage.io/v1alpha1
kind: API
metadata:
  name: wealthwise-api
  title: WealthWise API
  description: Authenticated financial guidance, investment scenarios and per-user history.
spec:
  type: openapi
  lifecycle: experimental
  owner: group:default/developers
  system: wealthwise
  definition: |
    {{ openapi.json | combine({"servers":[{"url":application_url}]}) | to_nice_json | indent(4) }}
{% if splunk_enabled | default(false) %}
---
apiVersion: scaffolder.backstage.io/v1beta3
kind: Template
metadata:
  name: wealthwise-splunk-onboarding
  title: Onboard WealthWise application logs
  description: Register the deployed WealthWise application and open its authenticated Splunk view. Requires the configured Splunk integration. This does not create a second application deployment.
spec:
  owner: group:default/platform-admins
  type: service
  parameters: []
  steps:
  - id: lookup
    name: Check whether WealthWise is already registered
    action: catalog:fetch
    input:
      entityRef: component:default/wealthwise
      optional: true
  - id: register
    if: '{{ '${{ not steps.lookup.output.entity }}' }}'
    name: Register WealthWise and its approved observability binding
    action: catalog:register
    input:
      catalogInfoUrl: https://bitbucket.org/{{ workspace }}/{{ repo_name }}/src/main/catalog-info.yaml
  output:
    links:
    - title: Inspect WealthWise in Splunk
      url: /catalog/default/component/wealthwise/splunk
    - title: Open WealthWise
      url: '{{ application_url }}'
    - title: Run one controlled error (sign in to WealthWise first)
      url: '{{ application_url }}/api/demo/operational-check?fail=true'
    - title: Confirm healthy response
      url: '{{ application_url }}/api/demo/operational-check?fail=false'
{% endif %}
