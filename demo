#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
case "${1:-all}" in
  all|apply)
    python3 -m unittest discover -s tests
    python3 scripts/provision.py
    python3 scripts/run_checks.py app
    if [ "${1:-all}" = all ]; then
      python3 scripts/catalog.py
      python3 scripts/run_checks.py catalog
    fi
    ;;
  verify) python3 scripts/run_checks.py app ;;
  onboard) python3 scripts/catalog.py; python3 scripts/run_checks.py catalog ;;
  build) bash scripts/build.sh ;;
  *) printf '%s\n' 'Usage: bash demo [all|apply|verify|onboard|build]'; exit 2 ;;
esac
